# Path of the SQLite database file (inside the container this is /data/app.db)
DATABASE_PATH=/data/app.db

# Any long random string; used to sign nothing today but reserved for cookies/CSRF.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Web Push VAPID keys. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or URL identifying the operator
VAPID_SUBJECT=mailto:you@example.com

# Public URL the app is reached at (your tailscale HTTPS URL)
APP_URL=https://your-machine.your-tailnet.ts.net

# Timezone the daily 03:00 backup runs in (the container itself runs in UTC)
TZ=Asia/Riyadh
